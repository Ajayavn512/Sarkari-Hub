rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'savedLinks'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedLinks', 'email'])
        && (!request.resource.data.keys().hasAny(['email']) || request.resource.data.email == request.auth.token.email);
      allow delete: if false;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Bootstrap admins manually in Firebase Console only.
    }

    match /announcements/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}